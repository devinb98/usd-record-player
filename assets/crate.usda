            float inputs:roughness = 0.7
            token outputs:surface
        }
    }

    def Cube "WallE" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Crate/WallE_mat>
        double size = 1
        float3 xformOp:scale = (0.02, 0.05, 0.34)
        double3 xformOp:translate = (0.16, 0.025, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "WallE_mat"
    {
        token outputs:surface.connect = </Crate/WallE_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.35, 0.24, 0.12)
