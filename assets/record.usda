#usda 1.0
(
    defaultPrim = "Record"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Record" (
    kind = "component"
)
{
    def Cylinder "Vinyl" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        float3[] extent = [(-0.145, -0.002, -0.145), (0.145, 0.002, 0.145)]
        double height = 0.004
        rel material:binding = </Record/Vinyl_mat>
        double radius = 0.145
    }

    def Material "Vinyl_mat"
    {
        token outputs:surface.connect = </Record/Vinyl_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
            float inputs:metallic = 0
            float inputs:roughness = 0.15
            token outputs:surface
        }
    }

    def Cylinder "Label" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        float3[] extent = [(-0.05, -0.00225, -0.05), (0.05, 0.00225, 0.05)]
        double height = 0.0045
        rel material:binding = </Record/Label_mat>
        double radius = 0.05
        double3 xformOp:translate = (0, 0.0003, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "Label_mat"
    {
        token outputs:surface.connect = </Record/Label_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.75, 0.18, 0.12)
            float inputs:metallic = 0
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    def Cube "Marker" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Record/Marker_mat>
        double size = 1
        float3 xformOp:scale = (0.012, 0.004, 0.012)
        double3 xformOp:translate = (0.085, 0.004, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "Marker_mat"
    {
        token outputs:surface.connect = </Record/Marker_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.9, 0.3)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }
}

