#usda 1.0
(
    defaultPrim = "Record"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Record" (
    kind = "component"
    variants = {
        string album = "Classic"
    }
    prepend variantSets = "album"
)
{
    def Cylinder "Vinyl" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        float3[] extent = [(-0.145, -0.003, -0.145), (0.145, 0.003, 0.145)]
        double height = 0.006
        rel material:binding = </Record/Vinyl_mat>
        double radius = 0.145
    }

    def Material "Vinyl_mat"
    {
        token outputs:surface.connect = </Record/Vinyl_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
            float inputs:metallic = 0
            float inputs:roughness = 0.15
            token outputs:surface
        }
    }

    def Cylinder "LabelA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        float3[] extent = [(-0.05, -0.0005, -0.05), (0.05, 0.0005, 0.05)]
        double height = 0.001
        rel material:binding = </Record/LabelA_mat>
        double radius = 0.05
        double3 xformOp:translate = (0, 0.0035, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "LabelA_mat"
    {
        token outputs:surface.connect = </Record/LabelA_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor
            float inputs:metallic = 0
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    def Cylinder "LabelB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        float3[] extent = [(-0.05, -0.0005, -0.05), (0.05, 0.0005, 0.05)]
        double height = 0.001
        rel material:binding = </Record/LabelB_mat>
        double radius = 0.05
        double3 xformOp:translate = (0, -0.0035, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "LabelB_mat"
    {
        token outputs:surface.connect = </Record/LabelB_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor
            float inputs:metallic = 0
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    def Cube "MarkerA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Record/MarkerA_mat>
        double size = 1
        float3 xformOp:scale = (0.012, 0.004, 0.012)
        double3 xformOp:translate = (0.085, 0.004, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "MarkerA_mat"
    {
        token outputs:surface.connect = </Record/MarkerA_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.9, 0.3)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }

    def Cube "MarkerB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Record/MarkerB_mat>
        double size = 1
        float3 xformOp:scale = (0.012, 0.004, 0.012)
        double3 xformOp:translate = (0.085, -0.004, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "MarkerB_mat"
    {
        token outputs:surface.connect = </Record/MarkerB_mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.3, 0.85, 0.9)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }
    variantSet "album" = {
        "Classic" {
            over "LabelA_mat"
            {
                over "Preview"
                {
                    color3f inputs:diffuseColor = (0.75, 0.18, 0.12)
                }
            }

            over "LabelB_mat"
            {
                over "Preview"
                {
                    color3f inputs:diffuseColor = (0.9, 0.85, 0.7)
                }
            }

        }
        "Jazz" {
            over "LabelA_mat"
            {
                over "Preview"
                {
                    color3f inputs:diffuseColor = (0.1, 0.5, 0.5)
                }
            }

            over "LabelB_mat"
            {
                over "Preview"
                {
                    color3f inputs:diffuseColor = (0.85, 0.65, 0.1)
                }
            }

        }
        "Night" {
            over "LabelA_mat"
            {
                over "Preview"
                {
                    color3f inputs:diffuseColor = (0.35, 0.2, 0.55)
                }
            }

            over "LabelB_mat"
            {
                over "Preview"
                {
                    color3f inputs:diffuseColor = (0.7, 0.72, 0.75)
                }
            }

        }
    }
}

